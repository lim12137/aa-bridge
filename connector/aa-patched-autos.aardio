}

import web.rest.aiChat.settingForm;
mainForm.btnSetting.oncommand = function(id,event){
	mainForm.cancelRetry();
	
	table.assign(config,{
		title = "AA( aardio autos ) - 设置"; // 标题  
		hyperlink1Title = "获取 key"; // key 输入框显示嵌入链接
		f1Title = "允许使用此接口的视觉能力";
		f1MultiSelect = true;
		allowKatex = true;//Win10+
	});
		
	//打开 AI 设置窗口，参数 2 指定配置文件
	var frmSetting = web.rest.aiChat.settingForm(mainForm,config);

	//== AA-BRIDGE PATCH(2/4): 设置窗注入「外部桥」开关（位于公式框与保存按钮之间空位）==
	try{
		frmSetting.add(
		chkBridge={cls="checkbox";text="外部桥";left=410;top=535;right=488;bottom=555;db=1;dr=1}
		);
		frmSetting.chkBridge.checked = AA_BRIDGE_CFG.enabled === true;
		frmSetting.chkBridge.oncommand = function(id,event){
			var on = frmSetting.chkBridge.checked;
			AA_BRIDGE_CFG.enabled = on;
			try{
				var t = fsys.table( io.appData("aardio/autos/aa-bridge.table") );
				t.enabled = on; t.token = AA_BRIDGE_CFG.token; t.save();
			}
			catch(e){}
			if( on ){
				if( mainForm.aaBridgeStart ) mainForm.aaBridgeStart();
			}
			else{
				if( mainForm.aaBridgeStop ) mainForm.aaBridgeStop();
			}
		}
	}
	catch(e){}

	//用户点击了「保存」 			
	if( frmSetting.doModal(mainForm) ){ 
		mainForm.cancelRetry();
		
		//获取用户当前选择的配置
		var configItem = config.itemData[config.selItem]; 
		if(configItem){
			
			if( configItem.model && configItem.key ){
				
				var cretePromptCacheKey = function(){
					import crypt;
					return crypt.sha256( configItem.key + ".aardio.autos." + io._exepath);
				}
				
				if( string.find( configItem.model,"!\wgpt!\W") 
					|| (string.find( configItem.model,"!\wgrok!\W") &&(configItem.protocol==="responses") )){
			
					if(configItem.extraHeaders[["x-grok-conv-id"]]){
						configItem.extraHeaders = null;
						config.save();
					}
						
					configItem.extraParameters = ..table.mix( configItem.extraParameters,{
						prompt_cache_key = cretePromptCacheKey();
					})
					
					config.save();
				}
				else{
					
					if(configItem.extraParameters[["prompt_cache_key"]]){
						configItem.extraParameters = null;
						config.save();
					}
				
					if( string.find( configItem.model,"!\wgrok!\W") ){
				
						if( type(configItem.extraHeaders)!="table"){ 
							configItem.extraHeaders  = {
								"x-grok-conv-id" = cretePromptCacheKey();
							}
							config.save();
						}
					}
					elseif(configItem.extraHeaders[["x-grok-conv-id"]]){
						configItem.extraHeaders = null;
						config.save();
					}
				}
			}
					
			aiChatConfig = table.assign({},configItem); 
			if(!chatUi.started()){
 				resetMessages(); 
 			} 
		} 
	}
}

mainForm.btnClear.oncommand = function(id,event){
	mainForm.btnSend.disabled = true;
	
	mainForm.cancelRetry();

	if(chatUi.aiChatThread){
		..thread.terminate(chatUi.aiChatThread,0)
		..raw.closeHandle(chatUi.aiChatThread)
		chatUi.aiChatThread = null;
	}

	io.close();
	resetMessages();//清除聊天上下文
	
	//清除附件图像
	var oldBmp = mainForm.btnImageAttachment.setForeground(null);
	if(oldBmp) oldBmp.delete();
	mainForm.btnImageAttachment.newImageAttached = null;
	mainForm.btnImageAttachment.iconText = '\uF030';
	
	mainForm.editPrompt.setFocus();
	mainForm.showMessage("✅ 已重新读取并刷新主记忆 ……");
	
	mainForm.btnSend.disabled = false;
}

mainForm.btnCopy.oncommand = function(id,event){
	var md;
	if(::GetKeyState(0x10/*_VK_SHIFT*/) & 0x8000){
		md = chatUi.getMarkdown();
		md = string.replace(md,`^.+\<span class="chat-role assistant"\>(.+?)\</span\>\s*`,``,1);
		md = string.replaceLiteral(md,`<span></span>`,``);
		
		if(::GetKeyState(0x11/*_VK_CTRL*/) & 0x8000){
			if(string.indexOf(md,"<details><summary>推理过程</summary><blockquote>")){
				md = '分析以下 AI 的思考过程，理一理他在纠结一些什么，踩了哪些坑：\n\n---\n\n' + md;
			}
		}
	}
	else{
		md = chatUi.lastAssistantMessage(true)
	}
	
	if(!#md) return mainForm.msgboxErr("未复制任何内容，AI 回复内容为空！");
	
	win.clip.write( string.crlf(md,'\r\n') );
	mainForm.btnCopy.disabledText = {'\uF254';'\uF251';'\uF252';'\uF253';'\uF250';text=''} 
	thread.delay(800);
	mainForm.btnCopy.disabledText = null;
}

mainForm.weixinSendMessage = function(fromMsg,textContent,final){

	if(mainForm.btnSend.busy()){
		thread.set("fromWeiXinClawBotMessage",fromMsg); 
		return "抱歉我正在思考，等我忙完立即联系您。";
	}
	elseif(mainForm.retryTimerId){
		return "抱歉我正在执行重试任务，当前故障：`" + (mainForm.lastApiError||"") + "`";
	}
	else{
		mainForm.fromFeishuMessageId = null;
		mainForm.fromWeiXinClawBotMessage = fromMsg;
		
		if(!final){
			chatUi.prompt(textContent,,true/*暂不发送到界面*/);
			config.chatMessages = chatUi.chatMessages;
			mainForm.saveChatMessage();
		}
		else{  
			sendApiMessage(false,textContent); 
		}
	}	
}

// 飞书消息处理函数
mainForm.feishuSendMessage = function(messageId,requestText,attachmentNotice){
	if( mainForm.fromFeishuMessageId == messageId ){
		return mainForm.btnSend.busy()?"我正在思考 ……":null;
	}
	
	if(mainForm.btnSend.busy()){
		thread.set("fromFeishuMessageId",messageId);
		return "抱歉我正在思考，等我忙完立即联系您。";
	}
	elseif(mainForm.retryTimerId){
		return "抱歉我正在执行重试任务，当前故障：`" + (mainForm.lastApiError||"") + "`";
	}
	else{
		mainForm.fromWeiXinClawBotMessage = null;
		mainForm.fromFeishuMessageId = messageId;
		
		if(attachmentNotice){
			chatUi.prompt(attachmentNotice,,true);
			
			config.chatMessages =  chatUi.chatMessages;
			mainForm.saveChatMessage();
		}
		
		if(requestText){
			sendApiMessage(false,requestText); 
		}
	}	
}

import win.debounce;
var hideMessage = win.debounce(
	function(){
		mainForm.lableMessage.show(false);
	},3000);
	
mainForm.lableMessage.orphanWindow(true);
mainForm.showMessage = function(content,msgType,popup){
	if(!content){
		mainForm.lableMessage.show(false);
		return ;
	}
	
	if(mainForm.btnSend.busy() || popup){
		content = string.replace(content,'\r?\n'," ");
		 mainForm.lableMessage.color = 0xFFFFFFFF;
		if(msgType=="error") {
            mainForm.lableMessage.background = 0xFFF56C6C;
        }
        elseif(msgType=="loading") {
            mainForm.lableMessage.background = 0xFF409EFF;
        }
        else/*if(msgType=="success")*/{
           mainForm.lableMessage.background = 0xFF67C23A;
		}
		
		mainForm.lableMessage.text = content;
		mainForm.lableMessage.show();
		hideMessage();
	}
	else{
		var overwrite = !chatUi.started();
		
		if(msgType=="error") chatUi.errorMessage(content,overwrite);
		elseif(msgType=="loading") chatUi.showLoading(content,overwrite);
		else/*if(msgType=="success")*/ chatUi.successMessage(content,overwrite); 
	} 
}

mainForm.editPrompt.oleCallback(
	
	
	GetDragDropEffect = function(drag,grfKeyState,effect){
		return 0,1/*_DROPEFFECT_COPY*/
	};

	QueryAcceptData = function(ptrDataObj,format,reco,really,hMetaPict){
	
		if(really){
			
			var dataObj = com.interface.IDataObject(ptrDataObj);
			
			
			if(dataObj.isText()){
				var txt = dataObj.getText();
				if(txt){
					var b,e = mainForm.editPrompt.getSel();
					if(!e) mainForm.editPrompt.setSel(-1);
					
					if(..string.match(txt,"^\s*<%\{\}>|<%\[\]>\s*$") && ..string.indexOf(txt,'\n') ){
						if(JSON.tryParse(txt)){
							txt = '\r\n```json\r\n'+txt+'\r\n```\r\n';
						}
					}
					
					mainForm.editPrompt.selText = txt;	
				}
			}
			elseif( dataObj.isFile()){
				var files = dataObj.getDropFile();
				if(#files){
					mainForm.editPrompt.setSel(-1);
					mainForm.editPrompt.selText = " `" + string.join(files,",")+"` ";
				}
			}
			elseif( dataObj.isBitmap()){
				var bmp = dataObj.getBitmap();
				if(bmp){
					var oldBmp = mainForm.btnImageAttachment.setForeground(bmp);
					if(oldBmp) oldBmp.delete();
					
					mainForm.btnImageAttachment.newImageAttached = true;	
					mainForm.btnImageAttachment.iconText = null;	
				}
			}
			
			/*返回 0 继续默认处理，文本放入控件，返回 _S_FALSE 阻止默认处理。*/
			return 1/*_S_FALSE*/
		}
		
		return 0; 
	};
	
	GetContextMenu = function(selType,oleObj,charRange){
		mainForm.cancelRetry();
		
		var menuItems = {
			{ /*分隔线*/ };
				
				{ '导入对话';  function(id){
					import fsys.dlg;
					var path = fsys.dlg.open("*.jsonl|*.jsonl|*.json|*.json||","自 jsonl 或 json 文件导入对话");
					if(!path) return;
					
					chatUi.importChatMessagesFromFile(path);
				}; mainForm.btnSend.busy() ? 1/*_MF_GRAYED*/ : 0}; 
				
				{ "导出对话";  function(id){
					import fsys.dlg;
					var path = fsys.dlg.save("*.jsonl|*.jsonl|*.json|*.json||","导出对话到 *.jsonl");
					if(!path) return;
					
					var file,err = io.file(path,"w+b");
					if(!file) return mainForm.msgboxErr(err);
			 		
					var chatMessages = chatUi.chatMessages;
					
					if(..string.endsWith(path,".jsonl",true)){
						for(i=1;#chatMessages;1){
							var msg = chatMessages[i]
							var line  = JSON.stringify(msg,false,false);
							line = string.crlf(line,"")
							file.write(line,'\r\n');
						}
					}
					else {
						file.write((JSON.stringifyArray(chatMessages,true,false)));
					}
					
					file.close();
					
				}; #chatUi.chatMessages<3 ? 1/*_MF_GRAYED*/ : 0
			}; 
		}
		
		mainForm.editPrompt.popMenu(menuItems);
	};
)

var weixinListeningThread;
var weixinTokenPath;
mainForm.btnWeixin.oncommand = function(id,event){
	mainForm.cancelRetry();
	
	import web.rest.iLinkClient.login;
	
	if(!mainForm.btnWeixin.checked){
		if(weixinListeningThread){
			thread.terminate(weixinListeningThread,0)
			raw.closeHandle(weixinListeningThread);
			weixinListeningThread = null;
		}
		
		if(weixinTokenPath){
			io.remove(weixinTokenPath)
			weixinTokenPath = null;
		}
		
		mainForm.showMessage("✅ 微信机器人已断开连接，再次点击微信图标重新扫码连接。");
		return;
	}
	
	var bot,err = web.rest.iLinkClient.login(parent=mainForm;text="使用微信连接 aardio autos");
	if(bot) mainForm.showMessage('✅ 微信机器人已上线，可接收 / 发送文本、图片、文件 ... 再次点击微信图标断开连接。');
	else {
		if(#err ) mainForm.msgboxErr( err );
		mainForm.btnWeixin.checked = false;
		return;
	}
	
	weixinTokenPath = bot.config.tokenPath;
	weixinListeningThread = thread.create( 
		function(mainForm,chatUi){
			import autos.weixinClient;
			autos.weixinClient(mainForm,chatUi);	
		},mainForm,chatUi
	)
}

// 飞书配置和连接
var feishuClient;
var feishuConfig = fsys.table(io.joinpath(userDataPath,"feishu.table"));

var frmFeishu;
mainForm.feishuOnReady = function(){
	feishuClient = mainForm.feishuClientInstance;
	mainForm.btnFeishu.checked = true;
	if(frmFeishu && frmFeishu.valid){ 
		frmFeishu.setStatus("已连接", 0x00AA00);
		frmFeishu.close();
	}
	
	mainForm.btnFeishu.checked = true;
	mainForm.showMessage('✅ 飞书机器人已上线，可接收 / 发送文本、图片、文件 ... 再次点击飞书图标断开连接。');
}

mainForm.feishuOnError = function(err){
	if(!mainForm.btnFeishu.checked && (frmFeishu && frmFeishu.valid)){
		frmFeishu.setStatus("连接失败：" + (err || "未知错误"), 0xFF0000);
		frmFeishu.btnConnect.disabled = false;
	}
}

mainForm.feishuOnClose = function(reason){
	feishuClient = null;
	mainForm.feishuClientInstance = null;
	mainForm.btnFeishu.checked = false;
}

mainForm.btnFeishu.oncommand = function(id,event){
	mainForm.cancelRetry();
	
	import web.feishu.settingForm;
	
	// 如果已连接，断开连接
	if(!mainForm.btnFeishu.checked && feishuClient){
		feishuConfig.autoConnect = false;
		feishuConfig.save();
		
		feishuClient.stop();
		feishuClient = null;
		mainForm.feishuClientInstance = null;
		mainForm.btnFeishu.checked = false;
		mainForm.showMessage("✅ 飞书机器人已断开连接，再次点击重新连接。","success");
		return;
	}
	
	
	mainForm.btnFeishu.checked = false;
	
	// 打开配置窗口
	frmFeishu = web.feishu.settingForm(mainForm, feishuConfig);
	
	// 连接回调
	frmFeishu.onConnect = function(appId, appSecret){
		frmFeishu.setStatus("正在连接...", 0x0078D4);
		frmFeishu.btnConnect.disabled = true;
		
		thread.invoke(
			function(mainForm, chatUi, appId, appSecret){
				import win.ui;
				import autos.feishuClient;
	
				mainForm.showMessage("✅ 飞书机器人正在连接","loading");
				
				var client = autos.feishuClient(mainForm, chatUi, appId, appSecret);
				mainForm.feishuClientInstance = client;
				
				client.start();
				win.loopMessage();
			}, mainForm, chatUi, appId, appSecret
		);
	}
	
	frmFeishu.doModal();
}

if(feishuConfig.autoConnect && feishuConfig.appId && feishuConfig.appSecret ){
	mainForm.btnFeishu.checked = true;
	
	thread.invoke(
		function(mainForm, chatUi, appId, appSecret){
			import win.ui;
			import autos.feishuClient;

			mainForm.showMessage("✅ 飞书机器人正在连接","loading");
			
			var client = autos.feishuClient(mainForm, chatUi, appId, appSecret);
			mainForm.feishuClientInstance = client;
			
			client.start();
			win.loopMessage();
		}, mainForm, chatUi, feishuConfig.appId, feishuConfig.appSecret
	);	
}

mainForm.onDestroy = function(){

	try{ if( AA_BRIDGE_SERVER ) AA_BRIDGE_SERVER.stop() }catch(e){} //== AA-BRIDGE PATCH(3/4): 退出停服 ==

    if(mainForm.feishuClientInstance){
    	mainForm.feishuClientInstance.stop();
    	mainForm.feishuClientInstance = null;
    }
    feishuClient = null;
       
    if(weixinListeningThread){
    	..thread.terminate(weixinListeningThread,0)
    	..raw.closeHandle(weixinListeningThread);
    	weixinListeningThread = null;
    }
    
    eventStop.set();
    if(chatUi.aiChatThread){
    	if(!..thread.wait(chatUi.aiChatThread,200)){
    		..thread.terminate(chatUi.aiChatThread,0);
    	}
    	..raw.closeHandle(chatUi.aiChatThread);
    	chatUi.aiChatThread = null;
    }
    
    mainForm.saveChatMessage();
}

chatUi.importChatMessagesFromFile = function(path){

	var json = string.load(path);
	if(!#json){
		return mainForm.msgboxErr("无效对话数据")
	}
	
	var messages;
	
	if(..string.endsWith(path,".jsonl",true)){
		messages = JSON.ndParse(json);
	}
	else {
		messages = JSON.tryParse(json);
	}
	
	
	if(!#messages){
		return mainForm.msgboxErr("无效对话数据")
	}	
	
	chatUi.importChatMessages(messages)
}

chatUi.importChatMessages = function(messages){
	mainForm.cancelRetry();
	
	mainForm.btnClear.disabled = true;
	mainForm.btnSend.disabled = true;
	mainForm.btnSetting.disabled = true;
	mainForm.showMessage("✅ 正在刷新主记忆 + 恢复会话 ……");
	
	resetMessages(true);
	
	var last = messages[#messages];
	if((last[["role"]]=="assistant") && (!#last.content)){ 
		table.pop(messages);
	}

	for(i=1;#messages;1){
		var msg = messages[i];
		
		if(type(msg.content)!="string"){
			 
			if(msg[["role"]]!="user"){
				//resetMessages();
				break;
			}
			elseif(!..table.isArrayLike(msg.content)){
				//resetMessages();
				continue;
			}
		} 
		
		if(msg[["role"]]=="system"){
			if(i<= #chatUi.chatMessages){
				continue;
			}
			chatUi.system(msg.content)
		}
		elseif(msg[["role"]]=="user"){
			if(i<#messages){
				chatUi.promptOnce(msg.content)
			}
			else{
				mainForm.editPrompt.text = msg.content;
			}
		}
		elseif(msg[["role"]]=="assistant"){
			
			var content = msg.content;  
			if(#content) chatUi.assistantOnce(content);
		}
		else {
			resetMessages();
			break;
		} 
	} 	
	
	config.save();
	mainForm.showMessage(false);
	
	mainForm.btnClear.disabled = false;
	mainForm.btnSend.disabled = false;
	mainForm.btnSetting.disabled = false;	
}

mainForm.btnSend.disabled = true;	
if(config.chatMessages){
	chatUi.importChatMessages(config.chatMessages);
}
else{
	resetMessages();
	
	if(mainForm.editPrompt.hwnd!=win.getFocus()){
		mainForm.editPrompt.text = defaultPrompt
	}
}
mainForm.btnSend.disabled = false;	

mainForm.createHbitmapFromAttachment = function(){
	var bmp = mainForm.btnImageAttachment.foreground;
	if(type(bmp)==="table") return bmp.copyHandle();
}

mainForm.btnImageAttachment.onRightMouseUp = function(wParam,lParam){
	var oldBmp = mainForm.btnImageAttachment.setForeground(null);
	if(oldBmp) oldBmp.delete();
	mainForm.btnImageAttachment.iconText = '\uF030';
}

mainForm.btnImageAttachment.oncommand = function(id,event){
	mainForm.cancelRetry();
	mainForm.show(0);
	thread.delay(100);
	
	import gdip.snap;
	import mouse.screenArea;
	var screenArea = mouse.screenArea();
	screenArea.onSelectionChanged = function(rc){
		mainForm.btnImageAttachment.iconText = null;
		
		mainForm.btnImageAttachment.newImageAttached = true;	
		var oldBmp = mainForm.btnImageAttachment.setForeground( (gdip.snap(screenArea.hwnd,rc)) );
		if(oldBmp) oldBmp.delete();
		
		owner.endModal(true);
		
		mainForm.editPrompt.setFocus();
	}
	
	screenArea.doModal();
	
	mainForm.show(5/*_SW_SHOW*/);
}

mainForm.customChat.translateAccelerator = function(msg){
	if (   (msg.message == 0x100/*_WM_KEYDOWN*/) || (msg.message == 0x101/*_WM_KEYUP*/) ) {
		var vk = msg.wParam;
		if( vk == 0x74/*_VK_F5*/ ){
			import ide;
			ide.run();
			return true;   
		}
		
		if(( vk == 'N'# ) && ( ( ::GetKeyState(0x11/*_VK_CTRL*/) & 0x8000 ) == 0x8000 )) 
		{
			return true;   
		} 
	}  
	return chatUi._host.tranacc(msg)
}  

import win.ui.accelerator;
var accelerator = win.ui.accelerator([
    {
        vkey = 0x74/*_VK_F5*/;
        oncommand = function() {import ide;ide.run(); }
    };
],mainForm );

//================= AA-BRIDGE PATCH(4/4): 内嵌 HTTP 桥（/api/* + /mcp，127.0.0.1）=================
//运行模型：本块在 UI 线程执行（定义跨线程辅助入口 + 按 aa-bridge.table.enabled 决定是否启动服务）；
//请求处理在 simpleHttpServer 的工作线程池。aaBridgeApp 会被 marshal 到工作线程执行 ⇒ 函数体自包含：
//仅可依赖 threadGlobal 注入的 mainForm/chatUi、闭包捕获的局部变量、aardio 标准库；全局量在工作线程不存在。
import wsock.tcp.simpleHttpServer;

if( !#AA_BRIDGE_CFG.token ){
	AA_BRIDGE_CFG.token = "aa" ++ tostring( time.tick() ) ++ tostring( math.random(100000,999999) );
	try{
		var t = fsys.table( io.appData("aardio/autos/aa-bridge.table") );
		t.token = AA_BRIDGE_CFG.token; t.save();
	}
	catch(e){}
}

//──── UI 线程侧：跨线程辅助入口（工作线程经 mainForm 代理调用；weixinClient 同款，阻塞取返回值）────
mainForm.aaMcpGetStatus = function(){
	return {
		bridge = thread.get("(AABRIDGE_ON)") == true;
		busy = mainForm.btnSend.busy();
		buttonText = mainForm.btnSend.text;
		retrying = mainForm.retryTimerId != null;
		lastApiError = mainForm.lastApiError;
		messageCount = #chatUi.chatMessages;
		title = mainForm.text;
		port = AA_BRIDGE_PORT;
		pid = ::Kernel32.GetCurrentProcessId();
		version = autos.version;
	};
}
mainForm.aaMcpGetReply = function(){
	return { reply = chatUi.lastAssistantMessage(true) };
}
mainForm.aaMcpStop = function(){
	if( mainForm.btnSend.busy() ){
		mainForm.btnSend.oncommand(,0);  //busy 分支 = 请求停止（内置强杀计时）
		return { stopping = true };
	}
	return { stopping = false; comment = "当前空闲" };
}

//──── 服务启停（UI 线程；设置窗复选框、开机自启、远程 shutdown 共用）────
AA_BRIDGE_SERVER = null;
mainForm.aaBridgeStop = function(){
	if( !AA_BRIDGE_SERVER ) return;
	try{ AA_BRIDGE_SERVER.stop() }catch(e){}
	AA_BRIDGE_SERVER = null;
	thread.set("(AABRIDGE_ON)",false);
	mainForm.text = AA_BRIDGE_BASETITLE;
	mainForm.showMessage("外部桥已关闭");
}
mainForm.aaBridgeStart = function(){
	if( AA_BRIDGE_SERVER ) return;
	if( !#AA_BRIDGE_CFG.token ) return;

	var bridgePort = AA_BRIDGE_PORT;   //仅 UI 线程使用；工作线程拿不到闭包变量（marshal 只传字节码），token 经 threadGlobal 注入

	var aaBridgeApp = function(response,request,session){

		//──── 安全：token 门禁（本服务只绑 127.0.0.1，再校验 X-AA-Token）────
		//aaBridgeToken 由 threadGlobal 注入工作线程（闭包变量跨线程不可见）
		var tk = request.headers[["x-aa-token"]];
		if( !aaBridgeToken || (tk != aaBridgeToken) )
			return response.errorStatus(401,"bad or missing X-AA-Token",true);

		//──── 直通黑名单（用户拍板 2026-09-10：ide_* 放开加护栏；微信/飞书未配置屏蔽；
		//      普通文件/进程/http_get 屏蔽——zcode 原生已覆盖，仅保留下载与 GitHub 两套）────
		var allowAll = false;
		var exclude = { "weixin_send_message";"weixin_send_file";"feishu_send_message";"feishu_send_file";
			"list_directory";"read_text_file";"save_files";"load_string";"search_text";
			"patch_text_file";"edit_text_file";"rollback_text_file";"clean_backup_text_files";
			"process_popen";"process_execute";"process_powershell";
			"http_get" };

		var writeJson = function(obj,status){
			response.contentType = "application/json";
			var s = JSON.stringify(obj);
			response.headers["Content-Length"] = #s;
			response.status = status : 200;
			response.write(s);
			response.close(true);
		}
		var isExcluded = function(name){
			for(i=1;#exclude;1){ if(exclude[i]==name) return true; }
		}

		//──── ide_replace_code 护栏：活动编辑器若为 AA 源码则拒绝替换（用户铁律：禁止修改 AA 源码）────
		//判定法：沿编辑器控件父窗口链读标题，命中 AA 入口文件名 / 副本目录 / lib\autos 即拒绝
		var ideGuardAllowReplace = function(){
			import ide;
			import winex;
			var editor = ide.getActiveCodeEditor();
			if(!editor) return false;   //无活动编辑器时拒绝：禁止 handler 静默新建文档写入（2026-09-10 实测教训）
			var hwnd = editor.hwnd;
			if(!hwnd) return true;
			var getParent = ::User32.api("GetParent","addr(addr)");
			var p = hwnd;
			for(i=1;8;1){
				p = getParent(p);
				if(!p) break;
				var t = "";
				try{ t = winex.getText(p,260) : "" }catch(e){}
				if(#t){
					var lt = string.lower(t);
					if( string.find(lt,"autos\.aardio") || string.find(lt,"aa-bridge") || string.find(lt,"\\lib\\autos\\") ) return false;
				}
			}
			return true;
		}

		//──── 工具清单（38 个 autos 工具 + 4 个 aa_* 元工具）────
		var listTools = function(){
			import autos.tools.schemas;
			var tools = {
				{ name="aa_status"; description="查询 AA 智能体状态：桥/忙闲/重试中、会话消息数、最近错误、PID";
				  inputSchema={type="object";properties={}} };
				{ name="aa_read_reply"; description="读取 AA 最近一条助手回复(Markdown)";
				  inputSchema={type="object";properties={}} };
				{ name="aa_stop"; description="请求 AA 中止当前任务(等价于点『停止』)";
				  inputSchema={type="object";properties={}} };
			};
			for(i=1;#autos.tools.schemas;1){
				var f = autos.tools.schemas[i][["function"]];
				if( f && ( allowAll || !isExcluded(f.name) ) )
					table.push(tools,{name=f.name;description=f.description;inputSchema=f.parameters});
			}
			return { tools = tools };
		}

		//──── 工具调用（aa_* 走 UI 线程代理；其余 38 个直通 handlers，aiChat 库同款调用约定）────
		var callTool = function(name,args){
			select(name) {
				case "aa_status" { return mainForm.aaMcpGetStatus(),false; }
				case "aa_read_reply" { return mainForm.aaMcpGetReply(),false; }
				case "aa_stop" { return mainForm.aaMcpStop(),false; }
				else {
					if( !allowAll && isExcluded(name) ) return null,false;
					if( name=="ide_replace_code" && !ideGuardAllowReplace() )
						return {error="已按「禁止修改 AA 源码」护栏拒绝：当前活动编辑器疑为 AA 源码（autos.aardio / lib\\autos / aa-bridge）。请先 ide_new_code 新建文档或切换到其他编辑器再试。"},true;
					import autos.tools.handlers;
					if(!thread.get("(AAMCP_HANDLERS_INITED)")){
						var cfg;
						try{ cfg = eval( string.load(io.appData("aardio/autos/agent.table")) ) }
						catch(e){ cfg = null }
						cfg = cfg : {};
						autos.tools.handlers.__init__(null,{
							aiChatConfig = cfg[["itemData"]][[cfg[["selItem"]]]] : {};
							aiConfigItems = cfg[["itemData"]];
							chatUi = chatUi; mainForm = mainForm;
						});
						thread.set("(AAMCP_HANDLERS_INITED)",true);
					}
					var f = autos.tools.handlers[name];
					if(!f) return null,false;
					return f(args),false;
				}
			}
		}

		var withBusy = function(fn){
			if(thread.get("(AAMCP_TOOLS_BUSY)"))
				return null,{code=-32000;message="another tools/call is running, retry shortly"};
			thread.set("(AAMCP_TOOLS_BUSY)",true);
			var result,isErr;
			try{ result,isErr = fn(); }
			catch(e){ result,isErr = {error=tostring(e)},true; }
			thread.set("(AAMCP_TOOLS_BUSY)",null);
			return result,isErr;
		}

		//──── MCP 协议层（streamable HTTP 2025-06-18：POST 全回 application/json，通知 202，GET/DELETE 405）────
		var mcpHandle = function(){
			var origin = request.headers[["origin"]];
			if( origin && !string.find(string.lower(origin),"127\.0\.0\.1|localhost") )
				return response.errorStatus(403,"origin rejected",true);
			var pv = request.headers[["mcp-protocol-version"]];
			if( pv && pv!="2025-03-26" && pv!="2025-06-18" )
				return response.errorStatus(400,"Unsupported MCP-Protocol-Version",true);
			if( request.method=="GET" || request.method=="DELETE" )
				return response.errorStatus(405,"Method Not Allowed",true);
			if( request.method!="POST" )
				return response.errorStatus(405,"Method Not Allowed",true);
			var msg = request.postJson();
			if(!msg) return response.errorStatus(400,"Invalid JSON body",true);
			var method = msg[["method"]] : "";
			var id = msg[["id"]];
			if(method=="initialize"){
				import autos;
				var sid = tostring( time.tick() ) ++ tostring( math.random(100000,999999) );
				response.headers["Mcp-Session-Id"] = sid;
				var ver = msg.params[["protocolVersion"]];
				if( ver!="2025-03-26" && ver!="2025-06-18" ) ver = "2025-06-18";
				return writeJson({
					jsonrpc="2.0"; id=id;
					result={
						protocolVersion=ver;
						capabilities={ tools={ listChanged=false } };
						serverInfo={ name="aa-mcp"; version=autos.version ++ "+bridge1" };
						instructions="AA(aardio autos) 桥：autos 工具直通（含 aardio 代码执行与报错回传）；aa_status/aa_read_reply/aa_stop 用于查询状态与控制";
					}
				});
			}
			if( id===null || string.find(method,"^notifications/") ){
				response.status = 202;
				return response.close(true);
			}
			var result,err;
			if(method=="ping") result = {};
			elseif(method=="tools/list") result = listTools();
			elseif(method=="tools/call"){
				var name = msg.params[["name"]];
				if(!name) err = {code=-32602;message="missing tool name"};
				else{
					var toolRes,toolIsErr;
					toolRes,toolIsErr = withBusy(function(){ return callTool(name,msg.params[["arguments"]]) });
					if(toolRes===null) err = {code=-32602;message="Unknown tool: "++name};
					else{
						var text = type(toolRes)=="table" ? JSON.stringify(toolRes) : tostring(toolRes);
						result = { content = { { type="text";text=text } } };
						if(toolIsErr) result.isError = true;
					}
				}
			}
			else err = {code=-32601;message="method not found: "++method};
			if(err) return writeJson({ jsonrpc="2.0"; id=id; error=err },200);
			writeJson({ jsonrpc="2.0"; id=id; result=result },200);
		}

		//──── 原生 API 层（/api/*，curl/任意 HTTP 客户端直调）────
		var apiHandle = function(path){
			var m = request.method;
			if( m=="GET" && path=="/api/status" ) return writeJson(mainForm.aaMcpGetStatus());
			if( m=="GET" && path=="/api/tools" ) return writeJson(listTools());
			if( m=="GET" && path=="/api/reply" ) return writeJson(mainForm.aaMcpGetReply());
			if( m!="POST" ) return response.errorStatus(405,"Method Not Allowed",true);
			var body = request.postJson();
			if( path=="/api/stop" ) return writeJson(mainForm.aaMcpStop());
			if( path=="/api/shutdown" ){
				writeJson({ stopping=true });
				try{
					import fsys.table;
					var t = fsys.table( io.appData("aardio/autos/aa-bridge.table") );
					t.enabled = false; t.save();
				}
				catch(e){}
				try{ AA_BRIDGE_CFG.enabled = false }catch(e){}  //chunk 全局在工作线程不存在，尽力同步
				mainForm.aaBridgeStop();  //跨线程代理到 UI 线程停服（响应已写出）
				return;
			}
			if(!body) return response.errorStatus(400,"Invalid JSON body",true);
			if( path=="/api/tools/call" ){
				var name = body[["name"]];
				if(!name) return writeJson({ error="missing tool name" },400);
				var result,isErr = withBusy(function(){ return callTool(name,body[["arguments"]]) });
				if(result===null) return writeJson({ error="Unknown tool: "++name },404);
				return writeJson({ result=result; isError=isErr===true });
			}
			return response.errorStatus(404,"Not Found",true);
		}

		//──── 路由 ────
		var path = request.path : "/";
		if( path=="/mcp" ) return mcpHandle();
		if( string.find(path,"^/api/") ) return apiHandle(path);
		return response.errorStatus(404,"Not Found",true);
	}

	var ok,err;
	for(i=1;3;1){   //端口被旧实例占用时自动重试（等旧实例退出释放端口，2026-09-10 自重启实测教训）
		var srv = wsock.tcp.simpleHttpServer.mainThread(aaBridgeApp);
		srv.threadNum = 2;    //1 线程跑长任务，另 1 线程保 status/ping 应答不被卡死
		srv.documentRoot = io.createDir( io.appData("aardio/autos/aa-bridge-root") );  //空目录，避开默认文档分支
		srv.threadGlobal = { mainForm = mainForm; chatUi = chatUi; aaBridgeToken = AA_BRIDGE_CFG.token };  //注入请求线程全局（窗口跨线程代理 + 桥token）
		ok,err = srv.start("127.0.0.1",bridgePort);
		if(ok){
			AA_BRIDGE_SERVER = srv;
			thread.set("(AABRIDGE_ON)",true);
			mainForm.text = AA_BRIDGE_BASETITLE ++ " [MCP:" ++ bridgePort ++ "]";
			mainForm.showMessage("✅ 外部桥已就绪: http://127.0.0.1:"++bridgePort++"/api/status");
			break;
		}
		if(i<3) sleep(2500);
	}
	if(!ok) mainForm.msgboxErr("外部桥启动失败(端口 "++bridgePort++" 可能被占用)：\n"++(err:""));
}

if( AA_BRIDGE_CFG.enabled ) mainForm.aaBridgeStart();

//================================ AA-BRIDGE PATCH END ================================

win.loopMessage();
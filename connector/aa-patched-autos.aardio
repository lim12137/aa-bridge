mainForm.editPrompt.adjustInputLayout = function(focus){
	var w,h = mainForm.dpiScale(1,1);
	h = h * 50;
	
	focus = focus && !mainForm.btnSend.busy();
	
	if(focus){
		if( ! mainForm.editPrompt["(focusedHeight)"] ){
			mainForm.bkPrompt.top = mainForm.bkPrompt.top - h;
			mainForm.bkPrompt.redraw();
			mainForm.customChat.bottom = mainForm.customChat.bottom - h;
			mainForm.editPrompt.top = mainForm.editPrompt.top - h;		
			mainForm.editPrompt["(focusedHeight)"] = true;
		}
	}	
	else{
		if( mainForm.editPrompt["(focusedHeight)"] ){
			mainForm.bkPrompt.top = mainForm.bkPrompt.top + h;
			mainForm.bkPrompt.redraw();
			mainForm.customChat.bottom = mainForm.customChat.bottom + h;
			mainForm.editPrompt.top = mainForm.editPrompt.top + h;	
			mainForm.editPrompt["(focusedHeight)"] = false;	
		}
	}
}

mainForm.setIcon("~/examples/AI/autos.ico"); 
mainForm.show();

//创建 AI 聊天界面
import web.form.chat;
var chatUi = web.form.chat(mainForm.customChat);


//必须放在 mainForm.show() 后面（DPI 初始化完成），保证普屏/高分屏都至少调用一次
mainForm.afterDpiChanged = function(){ 
	mainForm.setIcon("~/examples/AI/autos.ico"); 
	chatUi.zoom(100);
}

import fsys.table;
var userDataPath = io.appData("aardio/autos");
var agentConfigPath = io.appData("aardio/autos/agent.table");
var agentWorkspace = io.createDir( io.joinpath(userDataPath,"workspace") ); 

var config = fsys.table(agentConfigPath,{
	itemNames = ["默认"];
	selItem = 1;
	itemData = [{
		url="https://api.deepseek.com/v1";
		key= '';
		model="deepseek-v4-pro";
		temperature=1;
		reasoning={"effort":"max 全力以赴"}
	}] 
});
var aiChatConfig = config.itemData[config.selItem];

import thread.event;
// 手动复位事件：set 后 wait(0) 会持续返回 true，直到下一轮请求调用 reset()。用于表示“用户已请求停止”的持续状态。
var eventStop = thread.event(,true);

import com.interface.ITaskbarList3;
var taskbar = _WIN7_LATER && com.interface.ITaskbarList3.Create();

var sendApiMessage = function(resentCot,prompt){
  
	//如果恢复标志与共享链不同步，按普通重试处理，不弹出恢复提示。
	if(resentCot && !..thread.get("resumeChainOfThought")){
		//恢复链在竞态中消失时安全降级为普通重试，不伪造“继续”请求。
		resentCot = false;
		mainForm.btnSend.text = "重试";
	}

 
	if(!aiChatConfig[["url"]] || string.find(aiChatConfig[["url"]],"aardio\.com") ){
		mainForm.btnSend.checked = false;

		mainForm.msgboxErr('请在设置中指定支持交错思考+工具调用的大模型。\n禁止在 AA 中使用 ai.aardio.com 接口！');
		mainForm.btnSetting.oncommand();
		return;
	}

    if(!resentCot){
        var clearPrompt;
        if(!prompt) {
        	prompt = mainForm.editPrompt.text;
        	clearPrompt = true;
        }
	
		if(mainForm.btnSend.text!=="重试"){
    		// 检查输入是否为空（移除首尾空白）
    		if(!#string.trim(prompt)){
        		mainForm.btnSend.checked = false;
        		
        		mainForm.msgboxErr("请输入提示词");
        		mainForm.editPrompt.setFocus();
        		return;
    		}	
		}
		else{
			chatUi.clearErrorMessage();
			
			//没有临时交错思维链时，空 assistant 只是上次中断留下的占位，重试必须重发原请求。
			var lastMessage = chatUi.chatMessages[#chatUi.chatMessages];
			if(lastMessage[["role"]]==="assistant" && !#lastMessage[["content"]]
				&& !lastMessage[["reasoning_content"]] && !#lastMessage[["tool_calls"]]){
				table.pop(chatUi.chatMessages);
			}
		}

    	// UI 状态变更
    	if(clearPrompt)mainForm.editPrompt.text = ""; // 清空输入  
    	
    	..thread.set("resumeChainOfThought",null);
    	..thread.set("resumeChainOfThoughtProtocol",null);
    	..thread.set("resumeInterruptedMessage",null);
    }
    elseif(!..thread.get("resumeChainOfThought")){
        //共享恢复链在竞态中消失时，安全降级为普通重试，不伪造“继续”链也不弹出误导性提示。
        mainForm.btnSend.text = "重试";
        return sendApiMessage(false,prompt);
    }
	
    mainForm.btnClear.disabled = true; 

    eventStop.reset(); 
	var loading = {'\uF254';'\uF251';'\uF252';'\uF253';'\uF250' }
	
	//显示动画，但启用按钮
	mainForm.btnSend.reduce(loading,function(value,index){
		if(value) mainForm.btnSend.iconText = value;
		return 150;
	} )	
	
	mainForm.btnSend.checked = true; 
	mainForm.btnSend.text = "停止";
	
	var shouldInjectImageContext;
    if(!resentCot){
    	chatUi.showLoading(" 正在思考...");
    	if(#prompt) {
    		chatUi.prompt(prompt);
			mainForm.editPrompt.setFocus();
			
			//只在“新图加入”时通知大模型一次，避免在后续多轮对话中产生冗余提示
			shouldInjectImageContext = mainForm.btnImageAttachment.newImageAttached && type(mainForm.btnImageAttachment.foreground)==="table";
			mainForm.btnImageAttachment.newImageAttached = null;
    	}
    }
    
    mainForm.editPrompt.adjustInputLayout(false);
    mainForm.btnSend.setFocus();
    
    config.chatMessages =  chatUi.chatMessages;
	
	if(taskbar) taskbar.SetProgressState(mainForm.hwnd,1/*_TBPF_INDETERMINATE*/);

    // 创建 AI 对话线程
    chatUi.aiChatThread = thread.create( 
        function(chatUi,mainForm,aiChatConfig,aiConfigItems,eventStop,fromWeiXinClawBotMessage,fromFeishuMessageId,feishuClientInstance,resentCot,shouldInjectImageContext){
			
			var fib = ..fiber.create(function(){

            	import web.rest.aiChat;
            	import autos.tools.schemas;
          		import autos.tools.handlers;
          		import autos;
          		
            	aiChatConfig.tools = autos.tools.schemas;
            	aiChatConfig.userAgent = "autos/" + autos.version +"(Windows NT "+ _WIN_VER_MAJOR +"."+_WIN_VER_MINOR+"; +https://aau.cn)";
         
            	// 创建 AI API 客户端
            	var aiClient = web.rest.aiChat(aiChatConfig);
            	aiClient.setTimeouts(15000,30000,60000);
             	
            	if(inet.url.split(aiChatConfig.url)[["host"]]=="openrouter.ai"){
					aiClient.extraParameters = ..table.mix( aiClient.extraParameters,{
						session_id = "aardio-aautos-session-" + autos.version;
					})	
				}
            	
            	aiClient.referer = "https://aau.cn";
            	aiClient.setHeaders({
            	 	"X-Title":"aardio autos",
            	});
            	
            	import win.inputBox;
				..subscribe("afterConsoleOpen",function(){
					if(console){
						console.setTitle("autos console - 请勿关闭本窗口！！")
						
						console.setCtrlHandlerThread( function(ctrlType){
	 						mainForm.saveChatMessage(); //用户直接关闭 AI 打开的 console 窗口时保存对话
						},mainForm);			
					}
				} );
				
            	aiClient.external = autos.tools.handlers;
            	
				autos.tools.handlers.__init__(null,{
					aiChatConfig = aiChatConfig;
					aiConfigItems = aiConfigItems;
					chatUi = chatUi;
					fromWeiXinClawBotMessage = fromWeiXinClawBotMessage;
					fromFeishuMessageId = fromFeishuMessageId;
					feishuClientInstance = feishuClientInstance;
					mainForm = mainForm;
				});
				
            	var resumeChainOfThoughtProtocol;
            	var chatMessages = chatUi.chatMessages;
            	var hasRecoveryChain = resentCot;
            	var interruptedResponseContent = "";
            	var hasUncommittedResponse = false;
            	if(resentCot){
            		chatMessages = ..thread.get("resumeChainOfThought");
            		resumeChainOfThoughtProtocol = ..thread.get("resumeChainOfThoughtProtocol");
            		
            		if( resumeChainOfThoughtProtocol){
            	    	if(resumeChainOfThoughtProtocol!=aiClient._protocol){
            	    		chatUi.onComplete(false); 
            	    		chatUi.errorMessage("恢复思维链时不能将原接口使用的协议类型 " + resumeChainOfThoughtProtocol + " 更改为 " + aiClient._protocol);
            				mainForm.btnSend.text = "继续";
            				return;
            			}
            		}
            		
            		var interruptedMessage = ..thread.get("resumeInterruptedMessage");
            		if(interruptedMessage){
            			//仅折叠进 worker 的临时请求链，不修改 chatUi.chatMessages。
            			..table.push(chatMessages,interruptedMessage);
            			..thread.set("resumeInterruptedMessage",null);
            		}
            		
            		//恢复链已经折叠了上次临时 assistant；立即固定，避免本轮尚未收到新分片就被强制终止时丢失。
            		if(resentCot) ..thread.set("resumeChainOfThought",table.clone(chatMessages));
            		
            		var userPrompt = string.trim(mainForm.editPrompt.text);
            		if(#userPrompt){
            			..table.push(chatMessages,{
            				role = "user";
            				content = userPrompt;
            			});
            		}
            		else{
            			if(chatMessages[#chatMessages][["role"]]=="assistant"){
            				..table.push(chatMessages,{
            					role = "user";
            					content = "<session_resumed>Connection Restored</session_resumed>";
            				});
            			}
            		}
            		
            		//把已经折叠的临时 assistant、以及本次临时 user 提示固定为下一次恢复的基础链。
            		if(resentCot) ..thread.set("resumeChainOfThought",table.clone(chatMessages));
            		
            		mainForm.editPrompt.text = "";
            	}
            	elseif(shouldInjectImageContext){
            		var msg = chatMessages[#chatMessages];
            		if(msg.role=="user"){
            			msg.content = msg.content + '<context>用户提供了附件图像。如有必要，你可以调用工具 analyze_image 识别图像（`imageUrlOrPath` 参数请指定为 `attachment`）。</context>'
            		}
            	}
            	
            	aiClient.beforeToolCalling = lambda () !eventStop.wait(0);
            	aiClient.onToolCalling = lambda (name,args) !eventStop.wait(0);
            	aiClient.afterToolCalling = function (chatMessages){
                 	//已形成完整 assistant/tool 边界；后续子轮重新累计临时正文与 reasoning。
                 	hasRecoveryChain = true;
                 	
                 	..thread.set("resumeChainOfThought",chatMessages);
                 	..thread.set("resumeChainOfThoughtProtocol",aiClient._protocol);
                 	..thread.set("resumeInterruptedMessage",null);
                 	
                 	interruptedResponseContent = "";
                 	hasUncommittedResponse = false;
            	 	return !eventStop.wait(0);
            	}
            	aiClient.onToolCallingError = function(err, name, args){
            		chatUi.showThinking('\n\n工具`'+name+'` 调用时抛出异常:\n```\n'+tostring(err)+'\n```\n调用参数:\n```json\n'+JSON.stringify(args)+'\n```\n\n');
            	}
            	
            	var saveInterruptedState = function(){

            		if(aiClient._protocol!="openai" || !hasUncommittedResponse) return;
            		
            		if(!hasRecoveryChain){
            			//首次收到有效分片时建立临时基础链；零输出中断不会建立恢复链。
            			..thread.set("resumeChainOfThought",table.clone(chatMessages));
            			..thread.set("resumeChainOfThoughtProtocol",aiClient._protocol);
            			hasRecoveryChain = true;
            		}
            		
            		var interruptedMessage = {
            			role = "assistant";
            			content = interruptedResponseContent;
            		};
            		var reasoningContent = aiClient.reasoningContent;
            		
            		//服务端实际返回过 reasoning_content/reasoning 才放入临时恢复消息；空字符串同样保真。
            		if(reasoningContent!==null){
            			interruptedMessage.reasoning_content = reasoningContent;
            		}
            		
            		if(#aiClient.thinkingBlock) interruptedMessage.reasoning_details = aiClient.thinkingBlock;
            		if(#aiClient.encryptedContent) interruptedMessage.encrypted_content = aiClient.encryptedContent;
            		..thread.set("resumeInterruptedMessage",interruptedMessage);
            	}

            	::Kernel32.SetThreadExecutionState(0x80000003/*_ES_CONTINUOUS | _ES_SYSTEM_REQUIRED | _ES_DISPLAY_REQUIRED*/);//避免息屏
            	
            	::Kernel32.SetCurrentDirectory( (io.appData("aardio/autos/workspace")) );
            	
            	var ok,err,errCode,sendBackProtocol = aiClient.messages(chatMessages,
                	function(deltaText,reasoning){
						if(eventStop.wait(0)) return false;
						
                    	if(#reasoning){
                    		 hasUncommittedResponse = true;
                    		 
                    		 chatUi.showThinking(reasoning);
                    	}
                    	
                    	//纯推理分片的 deltaText 为空：不创建持久 assistant，但保留临时恢复状态。
                    	if(deltaText===null) chatUi.assistant(null);
                    	elseif(#deltaText){
                    		 hasUncommittedResponse = true;
                    		 
                    		 interruptedResponseContent = string.concat(interruptedResponseContent,deltaText);
                    		 chatUi.assistant(deltaText);
                    	}
                    	saveInterruptedState();
                	},resumeChainOfThoughtProtocol
            	);
            	
            	if((!ok || err || eventStop.wait(0)) && hasUncommittedResponse){
             		saveInterruptedState();
             	}
             	
             	var needRetry;
            	if(err){ 
                	needRetry = !eventStop.wait(0);
                	
                	if(errCode==12029){
                		chatUi.errorMessage(`无法与服务器建立连接！<a href="javascript:void(0)" onclick="javascript:external.updateApiKey()">点这里更换其他接口</a>`)
                	}
                	elseif(errCode==401){
                		chatUi.errorMessage(`API 密钥错误！&nbsp;<a href="javascript:void(0)" onclick="javascript:external.updateApiKey()">点这里设置新密钥</a> <code>`+(err||"404 Not Found")+`</code>`)
                		needRetry = false;
                	}
                	elseif(errCode===404){
                		chatUi.errorMessage("服务器不支持此接口或模型！<code>"+(err||"404 Not Found")+"</code>")
                		needRetry = false;
                	}
                	elseif( errCode==402 || ( type.isString(err) && string.find(string.lower(err)
                        	,`<%<<balance>|<credit>|<quota>|<key>|<limit>><<insufficient>|<exhausted>|<exceeded>|<run\s*out>>>|<%<<insufficient>|<exhausted>|<exceeded>|<depleted>|<requires more>><<balance>|<credit>|<quota>|<fund>>>`))
                    	){
                    		
                    	import web.rest.aiChat.settingForm;
                    	chatUi.errorMessage(string.concat(`余额 / 配额不足，<a href="`
                    		+ web.rest.aiChat.settingForm.getWebSite(aiChatConfig.url,"autos") 
                    		+`" title="此网址根据 API 接口地址自动生成，仅供参考">此 API 服务平台网址</a><br><code>`,err,"</code>"))
                   		
                   		//必须重试 » 微信飞书得到错误信息 » 充值 » 重试成功
                   		//订阅余额不足也可能返回 429，无法精确判断
                	}
                	elseif(type.isString(err) ){
                   	if( errCode===0 /*无其他错误*/){
                       	
                   	   	// 用户中止，且 errCode 为 0 （回复未完成、无其他错误）则不显示错误信息
                   	   	if( !eventStop.wait(0) /*非用户中止*/ ) {
                   	    		if(#err) chatUi.errorMessage(err);
                   	    		else {
                   	    	    	if(! ( fromWeiXinClawBotMessage || fromFeishuMessageId ) ){
                   	    	    		chatUi.errorMessage("服务器未发送有效回复正文！");
                   	    	    	} 
                   	    	    	else{
                   	    	    		err = null;
                   	    	    		errCode = null;
                   	    	    		needRetry = null;
                   	    	    		ok = true;
                   	    	    	}
                   	    		}
                   	   	}
                   		};
                   		elseif(#err) chatUi.errorMessage(err); 
                	}
                	else{
                		chatUi.errorMessage(err)
                	}	
            	}
           	
            	// 恢复按钮状态
            	chatUi.onComplete(ok,err,errCode); 
            	
            	autos.tools.handlers.__exit__()
      	
            	if(hasRecoveryChain && (!ok || err || eventStop.wait(0))){
                	
                	//仅在交错思考回传工具调用结果失败或用户点击“停止”才有必要恢复思维链（此注释不能删除）。
                	..thread.set("resumeChainOfThought",chatMessages);
                	
                	//初始流式请求 sendBackProtocol 仍可能为空，仍须锁定协议。
                	..thread.set("resumeChainOfThoughtProtocol",sendBackProtocol || aiClient._protocol);
 	
                	if( eventStop.wait(0) && !errCode ){ //errCode 为 0 表示未完成，对于中止操作来说是正常的
                		mainForm.btnSend.text = "继续";
                	}
                	else{
                		mainForm.btnSend.text = "重试";
                	}
            	}
            	else{
            		//避免旧协议原生状态滞留内存
            		..thread.set("resumeChainOfThought",null);
            		..thread.set("resumeChainOfThoughtProtocol",null);
            		..thread.set("resumeInterruptedMessage",null);
            		
            		if(err){
            			mainForm.btnSend.text = "重试";
            		}
            	}
             	
            	//任何原因异常中止，稍后自动重试
            	if(needRetry){
            		mainForm.scheduleRetry(err); 
            	}
            	
            	if(ok){
                	var wx = thread.get("fromWeiXinClawBotMessage"); 
            		var fs = thread.get("fromFeishuMessageId");
            		
            		if(wx){
            	    	thread.set("fromWeiXinClawBotMessage",null);
            	    	
            			import web.rest.iLinkClient.login;
    					var bot,err = web.rest.iLinkClient.login();
    					if(bot) bot.sendMessage(wx,"在吗？我已经忙完了！");
            		}
            		
            		if(fs){
            	    	thread.set("fromFeishuMessageId",null);
            	    	var feishuClientInstance = mainForm.feishuClientInstance;
            			if(feishuClientInstance) feishuClientInstance.replyMarkdown(fs, "在吗？我已经忙完了！");
            		}
            	}
            	
            	if(..win[["_form"]]){
					..win._form.destroyAll();
				}
            },io.appData("aardio/autos/workspace/"));
            
            var ok,err = fiber.resume(fib);
            if(!ok){
            	mainForm.msgboxErr(err||"未知错误")
            }
        },chatUi,mainForm,aiChatConfig,config.itemData,eventStop,mainForm.fromWeiXinClawBotMessage,mainForm.fromFeishuMessageId,mainForm.feishuClientInstance,resentCot,shouldInjectImageContext
    )
}

chatUi.onComplete = function(success,err,errCode){

	chatUi.assistant(null);//幂等结束 Markdown 流式渲染
	 
	mainForm.saveChatMessage();
	
	mainForm.btnSend.checked = false;
	mainForm.btnSend.disabledText = null;
	mainForm.btnSend.reduce(false);
	
	mainForm.btnSend.text = "运行";
	mainForm.btnSend.iconText = '\uF1B9';
	
	mainForm.btnClear.disabled = false; 
	if(success) {
		mainForm.retryAttempts = 0;
		mainForm.editPrompt.setFocus();
	}
	
	if(chatUi.aiChatThread){
		..raw.closeHandle(chatUi.aiChatThread);	
		chatUi.aiChatThread = null;	
	}
	
	if(mainForm.stopTimerId){
		mainForm.clearTimeout(mainForm.stopTimerId);
		mainForm.stopTimerId = null;
	}
	
	if(taskbar) taskbar.SetProgressState(mainForm.hwnd,0/*_TBPF_NOPROGRESS*/);
	
	if(config.playSound){
		import sys.midiOut;
		
		if(success){
			// 成功：马林巴（木琴系），节奏轻快紧凑，上扬琶音
            sys.midiOut.play("changeInstrument(13), 5__, 1'__, 3'__", "C4", 120);
		}
		elseif( !eventStop.wait(0) /*非用户中止*/ ) {
			// 失败：低音距的短促木鱼双击，提醒有误且不刺耳
            sys.midiOut.play("changeInstrument(115), 1_, 1_", "C3", 120);
		} 
	}
}

mainForm.saveChatMessage = function(){ 
	config.save();
}

chatUi.external = {
	alert = function(msg){
		mainForm.msgbox(msg," 🚗 aardio autos ");
	};
	updateApiKey = function(){
		mainForm.btnSetting.oncommand();
	};
	updateSearchKey = function(){
		var webSearchConfig = fsys.table(io.joinpath(userDataPath,"tavily.table"));
		var key = mainForm.inputBox("请输入密钥（自动识别 Tavily,Exa 等搜索接口密钥）","AA(aardio autos) - 搜索接口密钥",webSearchConfig.key,,true);
		if(key){
			webSearchConfig.key = key;
			webSearchConfig.save();
		}
	};
	openMemory = function(){
		raw.explore(io.createDir(io.joinpath(userDataPath,"~memory/")))
	};
	showMessage = function(msg){
		mainForm.showMessage(msg,,true)
	};
	importChatMessages = function(){
		import fsys.dlg;
		var path = fsys.dlg.open("*.jsonl|*.jsonl|*.json|*.json||","自 jsonl 或 json 文件导入对话");
		if(!path) return;
			
		chatUi.importChatMessagesFromFile(path);
	};
} 

mainForm.scheduleRetry = function(err){
	mainForm.lastApiError = err;
	
	var startTick = ..time.tick();
	mainForm.retryAttempts = math.min((mainForm.retryAttempts : 0) + 1,6);
	var delay = math.min( 15000 * (2 ** (mainForm.retryAttempts - 1)), 300000 );
	
	mainForm.lableMessage.background = 0xFFFFFBE6;
	mainForm.lableMessage.color = 0xFFD46B08;
	
	mainForm.retryTimerId = mainForm.setInterval( 
		function(){
			var endTick = ..time.tick()  
			var remain = endTick - startTick;
			if(remain>=delay){
				
				mainForm.clearTimeout(mainForm.retryTimerId);
				mainForm.retryTimerId = null;
				mainForm.lastApiError = null;
				mainForm.lableMessage.show(false);
				chatUi.clearErrorMessage();
				
				//按钮忙时不能再继续重试（对话历史会冲突），重试优先级不能高于 mainForm.btnSend
				if(!mainForm.btnSend.busy()){
					sendApiMessage( !!thread.get("resumeChainOfThought") );
				}
				
        		return 0;
			}
			else{
				mainForm.lableMessage.text = math.round((delay-remain)/60000,2) + " 分钟后自动重试";
				mainForm.lableMessage.show(true);
			}
		},3000 //3 秒无操作再启动
	)
}

mainForm.cancelRetry = function(){

    if(mainForm.retryTimerId){
        mainForm.clearTimeout(mainForm.retryTimerId);
    }

    mainForm.retryTimerId = null;
    mainForm.lastApiError = null;
    mainForm.retryAttempts = 0;
    mainForm.lableMessage.show(false);
}

mainForm.btnSend.oncommand = function(id,event){
	
	mainForm.cancelRetry();
	if( mainForm.btnSend.busy() /*mainForm.btnSend.text == "停止"*/){
		eventStop.set();
		
		mainForm.btnSend.checked = true;
		mainForm.btnSend.disabledText = {'\uF254';'\uF251';'\uF252';'\uF253';'\uF250'}
		
		mainForm.stopTimerId = mainForm.setTimeout( 
			function(){
				mainForm.stopTimerId = null;
				
				if( mainForm.btnSend.text == "停止"){
				
					if(chatUi.aiChatThread ){
						..thread.terminate(chatUi.aiChatThread,0)
						..raw.closeHandle(chatUi.aiChatThread)
						chatUi.aiChatThread = null;
					
						// 恢复按钮状态
            			chatUi.onComplete(null); 
						
						if( ..thread.get("resumeChainOfThought") ){ 
							mainForm.btnSend.text = "继续"
						}
						else{
							mainForm.btnSend.text = "重试"
						}
					}
				}
				
				return 0;
			},6000
		)
		return;
	} 
		
	if( ..thread.get("resumeChainOfThought") &&
		( (mainForm.btnSend.text=="继续") || (mainForm.btnSend.text == "重试")) ){
		//无论是手动中止（"继续"），还是服务端出错中止（"重试"），都需要恢复并续接原来的交错思维链
		chatUi.clearErrorMessage();
		sendApiMessage(true);
	}
	else{
		if( mainForm.btnSend.text != "重试" ){
			mainForm.fromWeiXinClawBotMessage = null;
			mainForm.fromFeishuMessageId = null;
		}
		
		sendApiMessage();	
	}
}

var defaultPrompt = "获取我的公网 IP，然后打开 必应 搜索此 IP";
mainForm.editPrompt.onFocusGot = function(){
	if(#defaultPrompt){
		if(owner.text == defaultPrompt){
			owner.text = "";
		}	
		
		defaultPrompt = "";	
	}
	 
	if(win.getIdleTime()<2000){
		mainForm.editPrompt.adjustInputLayout(true);
		mainForm.cancelRetry();	
	}
}
mainForm.editPrompt.onFocusLost = function(){
	mainForm.editPrompt.adjustInputLayout(false);
}
mainForm.editPrompt.langOptions = 2/*_IMF_AUTOFONT*/;

mainForm.editPrompt.onChange = function(){ 
	if(!owner.modified) return; //非交互操作或 text,load,save
	mainForm.cancelRetry(); //用户操作或 selText 等
}

//回车换行（Ctrl+Enter 发送）
mainForm.editPrompt.onOk = function(ctrl,alt,shift){

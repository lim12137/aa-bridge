import autos;
if(_WIN7_LATER) ::Shell32.SetCurrentProcessExplicitAppUserModelID(autos.appUserModelId) //在任务栏显示为分离图标（避免合并到 aardio.exe 分组）

//== AA-BRIDGE PATCH(1/4): 桥配置（外部桥 API/MCP :9123，设置窗可开关）==
AA_BRIDGE_PORT = 9123;
AA_BRIDGE_CFG = { enabled = true; token = "" };
AA_BRIDGE_BASETITLE = autos.title;
try{
	import fsys.table;
	var t = fsys.table( io.appData("aardio/autos/aa-bridge.table"),{enabled=true;token=""} );
	if( !#t.token ){
		t.token = "aa" ++ tostring( time.tick() ) ++ tostring( math.random(100000,999999) );
		t.save();
	}
	AA_BRIDGE_CFG.enabled = t.enabled !== false;
	AA_BRIDGE_CFG.token = t.token;
}
catch(e){ AA_BRIDGE_CFG.enabled = true; }
if( AA_BRIDGE_CFG.enabled )
	autos.title = AA_BRIDGE_BASETITLE ++ " [MCP:" ++ AA_BRIDGE_PORT ++ "]";

